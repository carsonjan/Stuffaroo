# Copy to apps/api/.env and fill in. Never commit real values.

# Tiger Cloud service URL (Postgres with pgvector + pgvectorscale), e.g.
# postgres://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Leave unset to use the local Docker database from `pnpm db:up`.
DATABASE_URL=

# Auth0: same values as apps/web/.env.local. Both are needed for any
# signed-in endpoint; without them those endpoints return 503.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Gemini embeddings for matching. Without either option below, matching falls
# back to keyword ranking and says so in the UI.
#
# Option A (recommended): Vertex AI on your Google Cloud project, billed to its
# free-trial credits. Enable the Vertex AI API on the project, then run
# `gcloud auth application-default login` once on this machine.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
#
# Option B: a Google AI Studio API key instead.
GEMINI_API_KEY=
# Optional overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# MATCH_MIN_SIMILARITY=0.55
