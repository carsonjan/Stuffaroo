# Copy to apps/api/.env and fill in. Never commit real values.

# Tiger Cloud service URL (Postgres with pgvector + pgvectorscale), e.g.
# postgres://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Leave unset to use the local Docker database from `pnpm db:up`.
DATABASE_URL=

# Google Gemini (AI Studio) key for listing and need embeddings. Without it,
# matching falls back to keyword ranking and says so in the UI.
GEMINI_API_KEY=
# Optional overrides
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# MATCH_MIN_SIMILARITY=0.55
