# Copy to apps/web/.env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_BASE_PATH is public; it is embedded at build time.

# Stuffaroo API (FastAPI)
API_URL=http://localhost:8000
# Set to /app for Vercel; leave empty for local development.
NEXT_PUBLIC_BASE_PATH=

# Auth0 (Regular Web Application). Leave any of these empty and the app still
# runs, with sign-in shown as "not configured".
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret for the session cookie: `openssl rand -hex 32`
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Identifier of the Auth0 API that represents the Stuffaroo API
AUTH0_AUDIENCE=
